# Copy to hancom.env and adjust after installing Hancom HWP SDK on Windows.
#
# The SDK guide describes Windows 10/11 support and Python binding through
# hwpsdk.py + SHDKFunctionExport.dll. Point HANCOM_SDK_DIR at the directory
# containing those files, or at the SDK root containing Bin/.
HANCOM_SDK_DIR=/mnt/c/Hancom/HWP_SDK/current/Bin
HANCOM_WINDOWS_PYTHON=/mnt/c/anaconda3/python.exe
CMD_EXE=/mnt/c/Windows/System32/cmd.exe

# This wrapper converts WSL paths and calls Windows Python through py.exe.
HANCOM_HWP2HWPX_CMD=scripts/hancom-hwp2hwpx-windows.sh
